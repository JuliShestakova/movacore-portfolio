%% MovaCore — Applied AI ads-ops workflow (production pattern, abstracted)
flowchart TB
  OP["Operator"] --> EP["Agent API"]
  EP --> SNAP["Build domain snapshot<br/>KPIs / context / tools"]
  SNAP --> LLM["LLM structured JSON call<br/>timeouts + retries"]
  LLM --> PARSE{"Schema valid?"}
  PARSE -->|no| ERR["Return safe error<br/>no side effects"]
  PARSE -->|yes| GATE["Policy allowlist gate"]
  GATE -->|blocked actions| SAN["Drop / sanitize"]
  GATE -->|ok| STORE["Persist plan + audit"]
  SAN --> STORE
  STORE --> UI["Human review UI"]
  UI -->|reject| AUD1["Audit reject"]
  UI -->|approve| EXEC["Execute allowlisted tools only"]
  EXEC --> ADS["Ads / domain API"]
  EXEC --> AUD2["Audit apply"]

%% MovaCore — request / data flow with errors and cache
flowchart TB
  C["Client<br/>React / Flutter"] --> A["FastAPI router"]
  A --> AUTH{"Auth OK?"}
  AUTH -->|no| E401["401/403 JSON error"]
  AUTH -->|yes| H["Domain handler"]

  H --> CACHE{"Cacheable<br/>and safe frame?"}
  CACHE -->|hit| R["JSON response"]
  CACHE -->|miss / unsafe| DB[(PostgreSQL / SQLite)]
  CACHE -->|miss shop search| SUP["Supplier APIs"]
  SUP --> VAL["Normalize + merge<br/>brand+PN dedupe"]
  VAL --> SAFE{"OEM analogs<br/>complete?"}
  SAFE -->|no| DROP["Do not mark resolved<br/>do not store bad frame"]
  SAFE -->|yes| SET["Optional Redis set"]
  DB --> R
  SET --> R
  DROP --> R
  R --> C

  H -->|long work| Q["RQ enqueue"]
  Q --> W["Worker"]
  W --> DB

  H -->|LLM path| LLM["Structured JSON"]
  LLM --> GATE["Validate + allowlist"]
  GATE -->|fail| EAI["Safe AI error"]
  GATE -->|ok| HITL["Human apply"]
